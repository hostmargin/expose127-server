# ── Ports ──────────────────────────────────────────────────────────────────────
# WebSocket port — CLI clients connect here
WS_PORT=4000

# HTTP port — public tunnel traffic comes in here (put Nginx in front on 80/443)
HTTP_PORT=3000

# ── Domain ─────────────────────────────────────────────────────────────────────
BASE_DOMAIN=hostmargin.com

# ── Limits ─────────────────────────────────────────────────────────────────────
# Max simultaneous tunnels
MAX_TUNNELS=1000

# Max requests per IP per minute (0 = disabled)
RATE_LIMIT_RPM=60

# Request body size limit in bytes (default 10 MB)
MAX_BODY_BYTES=10485760

# ── Auth tokens (optional) ─────────────────────────────────────────────────────
# If set, CLI clients must pass --token <value> to connect.
# Comma-separated list of valid tokens.
# Leave empty to allow anonymous connections (open/free tier).
# VALID_TOKENS=tok_abc123,tok_xyz789

# ── expose127 dashboard integration ─────────────────────────────────────────────
# SQLite file shared with the expose127 dashboard app (must be the same path/file
# on both sides — see C:\laragon\www\expose127). Personal --token values used by
# the CLI to identify a dashboard account are looked up here, not in VALID_TOKENS.
# DB_PATH=/var/www/vhosts/hmrg.xyz/httpdocs/tunnel-server/data/expose127.db

# How long to keep per-request log rows before pruning
LOG_RETENTION_DAYS=7

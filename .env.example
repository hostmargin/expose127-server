# ── Ports ──────────────────────────────────────────────────────────────────────
# WebSocket port — CLI clients connect here
WS_PORT=4000

# HTTP port — public tunnel traffic comes in here (put Nginx in front on 80/443)
HTTP_PORT=3000

# ── Domain ─────────────────────────────────────────────────────────────────────
BASE_DOMAIN=hostmargin.com

# ── Limits ─────────────────────────────────────────────────────────────────────
# Max simultaneous tunnels
MAX_TUNNELS=1000

# Max requests per IP per minute (0 = disabled)
RATE_LIMIT_RPM=60

# Request body size limit in bytes (default 10 MB)
MAX_BODY_BYTES=10485760

# ── Auth tokens (optional) ─────────────────────────────────────────────────────
# If set, CLI clients must pass --token <value> to connect.
# Comma-separated list of valid tokens.
# Leave empty to allow anonymous connections (open/free tier).
# VALID_TOKENS=tok_abc123,tok_xyz789
